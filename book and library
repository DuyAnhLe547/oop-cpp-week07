#include <iostream>
#include <string>
using namespace std;

struct Book {
    int id;
    string name;
    string author;
    double price;

    void inputInfo() {
        cout << "Nhap ID sach: ";
        cin >> id;

        cout << "Nhap ten sach: ";
        cin >> name;

        cout << "Nhap tac gia: ";
        cin >> author;

        cout << "Nhap gia sach: ";
        cin >> price;
    }

    void outputInfo() {
        cout << "ID: " << id << endl;
        cout << "Ten sach: " << name << endl;
        cout << "Tac gia: " << author << endl;
        cout << "Gia: " << price << endl;
    }
};


struct Library {
    int idLibrary;
    string nameLibrary;
    int numBooks;
    Book books[100];

    void inputLibrary() {
        cout << "Nhap ID thu vien: ";
        cin >> idLibrary;

        cout << "Nhap ten thu vien: ";
        cin >> nameLibrary;

        cout << "Nhap so luong sach: ";
        cin >> numBooks;

        for (int i = 0; i < numBooks; i++) {
            cout << "\n--- Sach thu " << i + 1 << " ---\n";
            books[i].inputInfo();
        }
    }

    void outputLibrary() {
        cout << "\n===== THONG TIN THU VIEN =====\n";
        cout << "ID thu vien: " << idLibrary << endl;
        cout << "Ten thu vien: " << nameLibrary << endl;
        cout << "So luong sach: " << numBooks << endl;

        for (int i = 0; i < numBooks; i++) {
            cout << "\n--- Sach thu " << i + 1 << " ---\n";
            books[i].outputInfo();
        }
    }

    void addBook(Book a) {
        books[numBooks] = a;
        numBooks++;
    }

    bool getBookInfo(int idBook, Book &result) {
        for (int i = 0; i < numBooks; i++) {
            if (books[i].id == idBook) {
                result = books[i];
                return true;
            }
        }

        return false;
    }

    Book* getBooks() {
        return books;
    }
};


int main() {
    Library library;

    library.inputLibrary();
    library.outputLibrary();


    cout << "\n them sach \n";
    Book newBook;
    newBook.inputInfo();
    library.addBook(newBook);

    cout << "\nSau khi them sach:\n";
    library.outputLibrary();


    cout << "\ntim sach\n";
    int idBook;
    cout << "Nhap ID sach can tim: ";
    cin >> idBook;

    Book result;

    if (library.getBookInfo(idBook, result)) {
        cout << "\nTim thay sach:\n";
        result.outputInfo();
    }
    else {
        cout << "Khong tim thay sach!\n";
    }


    cout << "\ndanh sach sach\n";

    Book* list = library.getBooks();
    for (int i = 0; i < library.numBooks; i++) {
        cout << "\nSach thu " << i + 1 << ":\n";
        list[i].outputInfo();
    }

    return 0;
}